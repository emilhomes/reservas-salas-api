# Copie este arquivo para .env e preencha (o .env NÃO vai para o Git).
# Banco EXCLUSIVO do serviço de reservas (no Neon: database "reservas_db").
DATABASE_URL=postgresql://USUARIO:SENHA@HOST.neon.tech/reservas_db?sslmode=verify-full
PORT=3000

# Endereços dos outros microsserviços (chamadas HTTP síncronas).
SALAS_URL=http://localhost:3001
USUARIOS_URL=http://localhost:3002

# Tempo máximo de espera por resposta de outro serviço, e quantas tentativas fazer.
HTTP_TIMEOUT_MS=5000
HTTP_TENTATIVAS=2
